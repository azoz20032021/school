# =============================================================================
#  نظام إدارة ثانوية المعالي الأهلية — متغيرات البيئة
#  انسخ هذا الملف إلى .env.local وعبّئ القيم. لا ترفع .env.local إلى Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) SESSION_SECRET  (مطلوب — الأهم)
# -----------------------------------------------------------------------------
# المفتاح الذي توقّع به جلسات الدخول. بدونه يستطيع أي شخص تزوير جلسة مدير.
# ولّده بهذا الأمر ثم الصقه هنا:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# -----------------------------------------------------------------------------
# 2) حساب الخادم في Firebase  (مطلوب لإقفال قاعدة البيانات)
# -----------------------------------------------------------------------------
# راجع التعليمات في firestore.rules. باختصار:
#   Firebase Console > Authentication > فعّل Email/Password
#   ثم أنشئ مستخدماً واحداً مخصصاً للخادم وضع بياناته هنا،
#   وضع الـ UID الخاص به داخل firestore.rules ثم انشر القواعد.
# بدون هذين المتغيرين تبقى قاعدة البيانات مفتوحة للقراءة من أي متصفح.
FIREBASE_SERVER_EMAIL=""
FIREBASE_SERVER_PASSWORD=""

# -----------------------------------------------------------------------------
# 3) SETUP_TOKEN  (اختياري)
# -----------------------------------------------------------------------------
# يحمي نقطة POST /api/setup التي تُنشئ أول حساب مدير.
# النقطة تعمل فقط عندما لا يوجد أي مدير في النظام، لكن ضبط هذا الرمز طبقة إضافية.
SETUP_TOKEN=""

# -----------------------------------------------------------------------------
# 4) إعدادات Firebase  (اختيارية — لها قيم افتراضية داخل الكود)
# -----------------------------------------------------------------------------
# اضبطها فقط إذا نقلت المشروع إلى مشروع Firebase آخر.
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""

# -----------------------------------------------------------------------------
# 5) تشغيل الخادم
# -----------------------------------------------------------------------------
PORT="3000"
NODE_ENV="development"
